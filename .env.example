# SuiteScout — copy to .env and fill in. Never commit .env.
# Vultr Serverless Inference API key (create at console.vultr.com).
VULTR_INFERENCE_API_KEY=
# Default inference model (OpenAI-compatible id on api.vultrinference.com).
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
# PostgreSQL connection string (REQUIRED — the app fails fast at
# startup without it). Shared platform-postgres on the VM, network
# vivescript-net; the `suitescout` database already exists there.
# <password> is the password of the `suitescout` DB user, set by the
# founder on the VM — never in the repo, never in chat.
DATABASE_URL=postgresql://suitescout:<password>@platform-postgres:5432/suitescout
# Admin login for the app (session login at /login). Set both values
# on the VM; they are the only login. Unset/empty either one =
# nobody can log in. Rotate any time with: edit .env, then
# `docker compose up -d` (never `restart` — it does not reload env).
# Never commit .env.
APP_USER=
# APP_PASSWORD also signs session cookies, so rotating it logs
# everyone out.
APP_PASSWORD=
# Read-only link to the Concierge database (optional). The
# superadmin_ro role has SELECT only — this app never writes to
# Concierge. Unset/unreachable = the Customers section of /board
# says "not configured" and everything else keeps working.
# <password> is the superadmin_ro password, set by the founder on
# the VM — never in the repo, never in chat.
CONCIERGE_DATABASE_URL=postgresql://superadmin_ro:<password>@platform-postgres:5432/concierge
# Write link for S3 admin actions (optional). The superadmin_rw role
# has UPDATE on three Property columns ONLY (adminHold, manualPlan,
# manualPeriodEnd) + SELECT on Property(id) for the WHERE clause —
# see the S2+S3 PR for the grant SQL. Unset = the suspend/manual
# actions answer 503 and change nothing. Used only inside action
# handlers in lib/concierge-write.ts — nowhere else opens this pool.
CONCIERGE_WRITE_DATABASE_URL=postgresql://superadmin_rw:<password>@platform-postgres:5432/concierge
# Stripe secret key for the S4 Rail A coupon flow (optional). Use a
# restricted key scoped to coupons + subscriptions. Test key in
# staging, live key on the VM. Unset = Rail A shows "not configured"
# and coupon applies fail soft (the discount stays approved); Rail B
# (quote/invoice lines) is unaffected. Never commit .env.
STRIPE_SECRET_KEY=
# Resend API key for outbound email (create at resend.com/api-keys).
# Unset = sending stays off; drafts still work, approve stays manual.
RESEND_API_KEY=
# Sender identity. Keep the mail subdomain (isolates reputation from
# the root domain); a human name beats info@ on opens and replies.
# The domain MUST be verified in Resend (SPF/DKIM/DMARC in DNS) or
# Resend only delivers to your own account email.
RESEND_FROM_EMAIL=amir@mail.vivereply.com
RESEND_FROM_NAME=Md Amir Hossain
# Auto-send kill switch. true = approving a qualified email draft
# (hot + researched email + pre-contact) sends it immediately.
# Anything else stays one human click away. Default off.
AUTO_SEND_ENABLED=false
# Rolling-24h send cap (fresh-subdomain ramp: start low). Max 100.
DAILY_SEND_CAP=10